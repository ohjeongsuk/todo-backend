# ==============================================================================
# 로컬 설정 예시 파일
#
# 이 파일을 application-local.yml 로 복사한 뒤 실제 값을 채운다.
#   cp application-local.yml.example application-local.yml
#
# 실행: ./mvnw spring-boot:run (application.yml 기본값이 local 프로파일이다)
# ==============================================================================
spring:
  datasource:
    username: postgres
    password: 여기에_로컬_DB_비밀번호를_입력한다
  jpa:
    hibernate:
      ddl-auto: update
  # Google Cloud Console에서 발급받은 로컬용 OAuth 클라이언트 값을 채운다.
  # 리다이렉트 URI로 http://localhost:8080/login/oauth2/code/google 을 등록해야 한다.
  security:
    oauth2:
      client:
        registration:
          google:
            client-id: 여기에_로컬용_구글_클라이언트_ID를_입력한다
            client-secret: 여기에_로컬용_구글_클라이언트_시크릿을_입력한다

# JWT 서명에 사용하는 시크릿. application.yml이 ${JWT_SECRET}로 필수 참조하므로
# 값이 없으면 기동이 실패한다. 로컬은 아무 임의 문자열이어도 되지만 운영은 충분히
# 무작위한 값을 환경변수로 주입한다 (CLAUDE.md 절대 규칙 9).
jwt:
  secret: 여기에_로컬용_임의_문자열을_입력한다
