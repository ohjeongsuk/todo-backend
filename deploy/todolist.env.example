# ==============================================================================
# 운영 서버 환경변수 예시 (systemd EnvironmentFile) — 단일 파일
#
# 이 파일은 "어떤 키가 필요한가"를 알리기 위한 예시이며 저장소에 커밋된다.
# 실제 값을 채운 파일 이름은 todolist.env 이고, 비밀을 담으므로 커밋하지 않는다
# (CLAUDE.md 절대 규칙 9). CHANGE_ME 로 표시된 값을 채워서 쓴다.
#
# 배치 위치: /etc/todolist/todolist.env
# 권한     : 600 root:root  (install.sh / 배포 절차가 설정한다)
#            systemd 가 root 로 읽어 환경변수로 넘긴 뒤 todolist 계정으로 낮춰 실행하므로,
#            서비스 계정에 읽기 권한을 줄 필요가 없다.
#
# ------------------------------------------------------------------------------
# 작성 규칙 (systemd EnvironmentFile 은 셸 스크립트가 아니다)
#   - KEY=VALUE 한 줄에 하나. 값에 공백이 있어도 따옴표 없이 쓴다.
#   - export 를 붙이지 않는다. $변수 치환·명령 치환이 동작하지 않는다.
#   - '#' 은 줄 맨 앞에서만 주석이다. 값 뒤에 붙이면 값의 일부가 된다.
#   - 줄바꿈은 LF 여야 한다. CRLF 면 값 끝에 \r 이 붙어 조용히 깨진다.
#
# ⚠️ 여기 있는 이름은 코드가 실제로 읽는 것과 한 글자도 다르면 안 된다.
#    이름이 다르면 경고 없이 무시되고, 기본값이 없는 키는 기동 실패로 이어진다.
#    (예: GOOGLE_CLIENT_ID 를 OAUTH_GOOGLE_CLIENT_ID 로 쓰면 기동하지 않는다)
#
# ⚠️ 이 파일은 비밀을 포함하므로 git 으로 추적하지 않는다 (CLAUDE.md 절대 규칙 9).
#    따라서 설정 변경 이력이 git 에 남지 않는다. 값을 바꿀 때는 무엇을 왜 바꿨는지
#    docs/ROADMAP.md 에 적어 두는 편이 좋다.
# ==============================================================================

# ------------------------------------------------------------------------------
# 프로파일 / 포트
#
# application.properties 의 spring.profiles.active 기본값이 local 로 하드코딩돼 있다.
# 이 줄이 없으면 운영 서버가 로컬 프로파일로 뜬다 (ddl-auto=update 라 운영 DB 스키마가
# 변경될 수 있다). 환경변수가 properties 파일보다 우선순위가 높아 여기서 덮어쓴다.
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# JVM 메모리 (t3.micro / RAM 1GB)
#
# -Xmx512m 은 "JVM 총 사용량이 512MB"라는 뜻이 아니다. 힙 밖의 메타스페이스·코드캐시·
# 스레드 스택이 200~300MB 를 더 쓴다. 그 합이 물리 메모리를 넘기면 커널 OOM Killer 가
# 자바를 죽인다. 그래서 힙 밖에도 상한을 걸고, 서버에는 스왑 2GB 를 만들어 뒀다.
# GC 는 vCPU 2개·1GB 환경에서 오버헤드가 낮은 SerialGC 로 고정한다.
# ------------------------------------------------------------------------------
JAVA_OPTS=-Xms256m -Xmx512m -XX:MaxMetaspaceSize=160m -XX:ReservedCodeCacheSize=96m -XX:+UseSerialGC -Duser.timezone=UTC -XX:+ExitOnOutOfMemoryError

# ------------------------------------------------------------------------------
# 데이터베이스 (RDS)
#
# 접속 URL 은 아래 3개로 조립된다 (application.properties).
# jdbc: 로 시작하는 통짜 URL 을 받는 변수는 없다. DB_HOST 에는 호스트명만 넣는다.
# ------------------------------------------------------------------------------
DB_HOST=todolistdb.crky6o6msmdm.ap-northeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=todolist_db
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# ------------------------------------------------------------------------------
# CORS / 프론트엔드
#
# CORS_ALLOWED_ORIGIN 은 단수형이다. 복수형(...ORIGINS)은 코드가 읽지 않는다.
# 쿠키를 쓰므로 와일드카드(*)는 사용할 수 없다 (CLAUDE.md 5장).
#
# FRONTEND_URL 은 비밀번호 재설정 링크와 Google OAuth2 콜백의 기준 주소다.
# 콜백 주소는 {FRONTEND_URL}/oauth/callback 으로 코드가 조립한다.
# 리다이렉트 주소를 직접 지정하는 변수는 없다.
#
# ⚠️ 빈 값으로 두지 말 것. 빈 문자열도 "설정됨"으로 취급되어 기본값을 덮어쓴다.
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGIN=https://main.d2y8rsr3tqdjn.amplifyapp.com
FRONTEND_URL=https://main.d2y8rsr3tqdjn.amplifyapp.com

# ------------------------------------------------------------------------------
# Refresh Token 쿠키 정책
#
# [1단계 임시값] 도메인·HTTPS 없이 EC2 IP + HTTP 로 운영하는 구간이다.
# 그 구간에서는 Secure 쿠키가 브라우저에서 거부되므로 Lax/false 로 둔다.
#
# [2단계 전환] nginx + Let's Encrypt 로 HTTPS 를 붙인 뒤 이 두 줄을 지운다.
# 지우면 application-prod.properties 의 기본값(None/true)으로 자동 복귀한다.
# cross-site(Amplify <-> API 도메인) 조합에는 SameSite=None; Secure 가 필수다.
# jar 재빌드는 필요 없다.
# ------------------------------------------------------------------------------
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 인증 시크릿
#
# 둘 다 HS256 서명 키이며 32바이트 이상이어야 한다. 서로 다른 값을 쓴다 -
# 같은 키를 두 용도로 쓰면 한쪽이 유출됐을 때 다른 쪽까지 위조 가능해진다.
# 생성: openssl rand -base64 48
#
# JWT_SECRET 을 바꾸면 발급된 Access Token 이 전부 무효가 된다.
# STORAGE_SIGNING_SECRET 을 바꾸면 발급된 첨부 조회 URL 이 전부 무효가 된다.
# ------------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME
STORAGE_SIGNING_SECRET=CHANGE_ME

# ------------------------------------------------------------------------------
# Google OAuth2
#
# 이름은 GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET 이다 (OAUTH_ 접두사 없음).
# 기본값이 없어 비면 기동에 실패한다.
# 1단계(HTTP)에서는 구글이 https 리다이렉트 URI 를 요구해 로그인이 동작하지 않지만,
# 기동을 위해 값 자체는 필요하다.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# ------------------------------------------------------------------------------
# AWS S3 (첨부 이미지 저장소)
# ------------------------------------------------------------------------------
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=todolist-dev-ojs933327

# [임시] IAM Role 대체 수단.
# 원래 설계는 EC2 에 IAM Role 을 부착해 DefaultCredentialsProvider 가 IMDS 에서
# 임시 자격증명을 받는 것이다. 그 편이 안전한 이유는 자격증명이 디스크에 남지 않고
# AWS 가 주기적으로 자동 교체해 주기 때문이다.
# [해소] IAM Role 부착 후 아래 두 줄을 지우고 systemctl restart todolist.
# 환경변수가 IMDS 보다 우선하므로, 지우면 자동으로 IAM Role 경로로 돌아간다.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
