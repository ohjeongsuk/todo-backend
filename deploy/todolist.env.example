# ==============================================================================
# 운영 서버 비밀 값 (systemd EnvironmentFile)
#
# 이 파일은 예시다. 값을 채운 실제 파일 이름은 todolist.env 이며 커밋하지 않는다
# (CLAUDE.md 절대 규칙 9, .gitignore 로 제외됨).
#
# 배치 위치: /etc/todolist/todolist.env
# 권한     : 600 root:root  (install.sh 가 설정한다)
#            systemd 가 root 권한으로 읽어 환경변수로 넘겨주므로, 서비스 계정
#            (todolist)에게 읽기 권한을 줄 필요가 없다. 좁게 잠글수록 좋다.
#
# 작성 요령
#   - KEY=VALUE 한 줄에 하나. export 를 붙이지 않는다.
#   - 값에 $ 나 따옴표가 들어가면 그대로 쓴다 (셸이 아니라 치환되지 않는다).
#   - '#' 은 줄 맨 앞에서만 주석이다.
#
# 여기 있는 6개는 전부 기본값이 없다. 하나라도 비면 애플리케이션이 기동하지 않는다.
# ==============================================================================

# --- RDS 접속 계정 ---
# 호스트·포트·DB명은 비밀이 아니므로 todolist.conf 에 있다.
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_RDS_PASSWORD

# --- JWT 서명 키 (HS256) ---
# 32바이트 이상. 생성: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_BYTES

# --- 첨부 조회 URL 서명 키 (HS256) ---
# JWT_SECRET 과 반드시 다른 값을 쓴다. 같은 키를 두 용도로 쓰면 한쪽이 유출됐을 때
# 다른 쪽까지 위조 가능해진다. 생성: openssl rand -base64 48
STORAGE_SIGNING_SECRET=CHANGE_ME_STORAGE_SIGNING_SECRET_AT_LEAST_32_BYTES

# --- Google OAuth2 ---
# 기본값이 없어 비워두면 기동에 실패한다. 배포 1단계(HTTP)에서는 구글 로그인이
# 동작하지 않지만(구글이 https 리다이렉트 URI 를 요구한다), 기동을 위해 값은 필요하다.
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
