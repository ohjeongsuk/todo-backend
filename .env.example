# ==============================================================================
# 환경변수 예시 파일
#
# 이 프로젝트는 로컬 개발 시 application-local.yml(git 추적 제외)로 비밀을 주입하고,
# 운영 배포 시에는 이 파일에 나열된 환경변수를 실제 값으로 채워 EC2에 설정한다.
# 이 파일 자체에는 실제 비밀 값을 넣지 않는다 (CLAUDE.md 절대 규칙 9).
# ==============================================================================

# --- 데이터베이스 ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=todolist_db
DB_USERNAME=
DB_PASSWORD=

# --- JWT ---
JWT_SECRET=
JWT_EXPIRATION=

# --- Google OAuth2 (Phase 5) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 프론트엔드 연동 ---
FRONTEND_URL=http://localhost:3000
