# ==============================================================================
# 백엔드 환경변수 예시 (CLAUDE.md 절대 규칙 9)
#
# 이 파일 자체는 커밋 대상이지만, 실제 값을 채운 .env 는 .gitignore 로 제외된다.
# 로컬 개발은 application-local.properties(git 비추적)로도 값을 채울 수 있어 .env가
# 필수는 아니다.
#
# 운영(EC2) 배포는 이 파일을 쓰지 않는다. systemd EnvironmentFile 두 개로 나눠 주입한다:
#   deploy/todolist.conf      - 비밀이 아닌 값 (git 추적)
#   deploy/todolist.env       - 비밀 값       (git 추적 제외, todolist.env.example 참고)
# 아래 목록은 "코드가 실제로 읽는 키"의 정본이다. 여기 없는 이름은 아무 효과가 없다.
# ==============================================================================

# --- 데이터베이스 ---
# 접속 URL은 아래 3개로 조립된다 (application.properties). jdbc: 로 시작하는 통짜 URL을
# 넣는 변수는 없다. DB_HOST 에는 호스트명만 넣는다.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=todolist_db
DB_USERNAME=postgres
DB_PASSWORD=qaz123

# --- JWT ---
# 최소 32바이트 이상의 무작위 문자열을 사용한다 (HS256 서명 키)
JWT_SECRET=여기에_JWT_시크릿을_입력한다

# --- CORS / 프론트엔드 ---
# 단수형 CORS_ALLOWED_ORIGIN 이다. 복수형(CORS_ALLOWED_ORIGINS)은 읽지 않는다.
# 와일드카드(*)는 쓸 수 없다 - 쿠키를 쓰므로 명시적 origin이어야 한다 (CLAUDE.md 5장).
# 로컬: http://localhost:3000, 운영: Amplify 배포 도메인
CORS_ALLOWED_ORIGIN=http://localhost:3000

# 비밀번호 재설정 링크와 Google OAuth2 콜백 리다이렉트의 기준 주소.
# 콜백은 {FRONTEND_URL}/oauth/callback 으로 코드가 조립한다 (OAuth2SuccessHandler).
# 리다이렉트 주소를 직접 지정하는 변수는 없다.
FRONTEND_URL=http://localhost:3000

# --- Google OAuth2 (Phase 5에서 사용) ---
# 기본값이 없어 비워두면 기동에 실패한다. 사용하지 않더라도 임의 값이라도 채워야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 첨부 스토리지 (Phase 13) ---
# 첨부 조회 URL 서명 키. JWT_SECRET 과 반드시 다른 값을 쓴다 (HS256, 32바이트 이상).
STORAGE_SIGNING_SECRET=여기에_스토리지_서명_시크릿을_입력한다

# 운영(app.storage.type=s3)에서만 사용한다. 로컬은 upload 디렉터리를 쓰므로 불필요하다.
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2

# AWS 자격증명(AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)은 여기에 적지 않는다.
# DefaultCredentialsProvider 체인이 처리한다 - EC2 는 IAM Role, 로컬 시험은 실행 환경변수.

# --- 프로파일 ---
# application.properties 의 spring.profiles.active 기본값이 local 로 하드코딩돼 있다.
# 운영 배포에서는 이 값을 반드시 prod 로 덮어써야 한다 (todolist.conf 가 담당).
# SPRING_PROFILES_ACTIVE=prod
