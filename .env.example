# ==============================================================================
# 백엔드 환경변수 예시 (CLAUDE.md 절대 규칙 9)
#
# 이 파일 자체는 커밋 대상이지만, 실제 값을 채운 .env 는 .gitignore 로 제외된다.
# 로컬 개발은 application-local.yml(git 비추적)로도 값을 채울 수 있어 .env가
# 필수는 아니다. 운영(EC2) 배포 시에는 아래 값을 실제 환경변수로 주입한다.
# ==============================================================================

# --- 데이터베이스 ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=todolist_db
DB_USERNAME=postgres
DB_PASSWORD=qaz123

# --- JWT ---
# 최소 32바이트 이상의 무작위 문자열을 사용한다 (HS256 서명 키)
JWT_SECRET=여기에_JWT_시크릿을_입력한다

# --- CORS / 프론트엔드 ---
# 로컬: http://localhost:3000, 운영: Amplify 배포 도메인
CORS_ALLOWED_ORIGIN=http://localhost:3000

# --- Google OAuth2 (Phase 5에서 사용) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
